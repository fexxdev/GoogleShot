{
  "name": "googleshot",
  "version": "0.3.12",
  "description": "Capture every slide of a Google Slides presentation or every page of a Google Doc as JPEG images and build a PDF.",
  "type": "module",
  "bin": {
    "googleshot": "bin/googleshot.js",
    "gshot": "bin/googleshot.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/googleshot.js",
    "build": "node scripts/build-extension.mjs",
    "release": "node scripts/bump-version.mjs && node scripts/build-extension.mjs",
    "promo": "node scripts/promo.mjs",
    "shots": "node scripts/shots.mjs",
    "pack": "node scripts/pack-extension.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "google-slides",
    "google-docs",
    "screenshot",
    "pdf",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "playwright": "1.58.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
