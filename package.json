{
  "name": "googleshot",
  "version": "0.2.2",
  "description": "Capture every slide of a Google Slides presentation or every page of a Google Doc as JPEG images and build a PDF.",
  "type": "module",
  "bin": {
    "googleshot": "bin/googleshot.js",
    "gshot": "bin/gshot.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/googleshot.js",
    "build": "node scripts/build-extension.mjs",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "google-slides",
    "google-docs",
    "screenshot",
    "pdf",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "1.58.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
